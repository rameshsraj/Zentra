# ============================================
# Zentra - Git Ignore
# ============================================

# Environment files (credentials)
#.env
.env.local
.env.test
deploy/deploy.env
.claude
.gitignore

# Build artifacts
/target/
/frontend/dist/
*.tsbuildinfo
build_output.txt

# Package manager dependencies
node_modules/*
frontend/node_modules/*
docs/node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.suo
*.user

# Logs
*.log
/logs/
artifacts/*


# Docker image tarballs (too large for git)
docker/zentra-latest.tar.gz
docker/local-lab/zentra-agent-latest.tar.gz

docker/*.tar.gz

# Simulation lab generated files
docker/simulation/docker-compose.generated.yml
docker/simulation/bin/

# Internal scratch docs (prompts, diagnostics, audits - not for repo)
docs/internal/

# Diagnostic / scratch output files
*.txt
build_diagnostics.txt
check_output.txt
check_db_removal.txt
api_check*.txt
full_cargo_check*.txt
full_check.txt
last_check.txt
final_check.txt
agent_errors.txt
api_errors.txt
errors.txt
errors_only.txt
last_errors.txt
error\ list
