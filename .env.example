# ---------------------------------------------------
# Zentra — Environment Configuration Example
# Copy this to .env and fill in your values
# ---------------------------------------------------

# PostgreSQL Database
POSTGRES_HOST=10.88.11.162
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=zentra
DATABASE_URL=postgresql://postgres:your_password_here@10.88.11.162:5434/zentra
DB_POOL_SIZE=10

# Application Ports
ZENTRA_API_PORT=5006
ZENTRA_AGENT_PORT=5001
METRICS_PORT=5002
FRONTEND_PORT=5010

# JWT Authentication (must be at least 32 chars)
ZENTRA_JWT_SECRET=change-this-to-a-strong-secret-at-least-32-bytes
ZENTRA_ALLOW_INSECURE_JWT=0

# CORS (comma-separated origins)
ZENTRA_ALLOW_ORIGINS=http://10.88.11.162:5010,http://localhost:5010

# Application
ZENTRA_LOG_LEVEL=info
ZENTRA_COLLECTION_INTERVAL=60
ZENTRA_DEMO_MODE=false

# Deployment
SERVER_HOST=10.88.11.162
SERVER_PORT=22
SERVER_USER=root
DEPLOY_PATH=/store/Zentra
