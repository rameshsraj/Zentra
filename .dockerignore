# =============================================================================
# Zentra — Docker Build Context Exclusions (Hardened)
# Only allow pre-built artifacts into the image — NO source code, NO credentials
# =============================================================================

# ── Source code (NEVER include) ──
crates/
plugins/
frontend/src/
frontend/node_modules/
frontend/package.json
frontend/package-lock.json
frontend/tsconfig*.json
frontend/vite.config.ts
frontend/tailwind.config.js
frontend/postcss.config.js
frontend/eslint.config.js
frontend/index.html
src/
Cargo.toml
Cargo.lock
*.rs
*.toml

# ── Credentials & environment files (NEVER include) ──
.env
.env.*
deploy/deploy.env

# ── Build artifacts & caches ──
target/debug/
target/.rustc_info.json
target/.cargo-lock
target/release/build/
target/release/deps/
target/release/examples/
target/release/incremental/
target/release/.fingerprint/
target/release/*.d
target/release/zentra-agent
# Allow: target/release/zentra-server (the binary)

# ── Git & IDE ──
.git/
.github/
.gitignore
.gitattributes
.vscode/
.idea/
.claude/
.cargo/
.windsurf/

# ── Deploy & docs ──
deploy/
docs/
tools/
*.md
!docker/README.md

# ── Log & check files (dev artifacts) ──
*.log
*.txt
agent_check.log
api_check.log
build_diagnostics.txt
check_output.txt
check_db_removal.txt
full_cargo_check*.txt
full_check.txt
last_check.txt
server_stdout.log
server_stderr.log
errors.txt
errors_only.txt
last_errors.txt
api_errors.txt
agent_errors.txt

# ── OS files ──
.DS_Store
._*
Thumbs.db

# ── Backups & binaries ──
backups/
bin/
logs/

# ── Docker image tarballs (don't nest images inside the build) ──
docker/zentra-latest.tar.gz
docker/simulation/
