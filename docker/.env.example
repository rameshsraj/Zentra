# =============================================================================
# Zentra — Docker Environment Variables
# Copy to .env and customize: cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (embedded)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=zentra
POSTGRES_PORT=5434

# ---------------------------------------------------------------------------
# Database URL (auto-constructed if not set — override for external DB)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:<your-db-password>@localhost:5434/zentra

# ---------------------------------------------------------------------------
# Zentra API
# ---------------------------------------------------------------------------
ZENTRA_API_PORT=5006

# IMPORTANT: Set a strong secret (>= 32 characters) for production
ZENTRA_JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long!!

# Set to 1 only for local development (bypasses JWT secret strength check)
# ZENTRA_ALLOW_INSECURE_JWT=0

# Organization ID (UUID)
ZENTRA_ORG_ID=00000000-0000-0000-0000-000000000001

# CORS allowed origins (comma-separated, or * for all)
ZENTRA_ALLOW_ORIGINS=*

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# ---------------------------------------------------------------------------
# Frontend port (nginx listens on this inside the container)
# ---------------------------------------------------------------------------
ZENTRA_FRONTEND_PORT=5010
